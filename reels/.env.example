# Copy this file to .env and fill in your key:   cp .env.example .env
# .env stays on your computer. Never share it and never commit it.

# Your ElevenLabs API key (elevenlabs.io > Developers > API keys).
ELEVENLABS_API_KEY=

# The two voices. Change these to any voice ID from your ElevenLabs account.
# 김대리
PIXEL_VOICE_ID=hp3u3xWyyDK3Zr5h8Ltt
# 클로드
CLAUDE_VOICE_ID=8zHuDw1bbkbkL93Inv5N

# Voice model. eleven_v4 understands the [emotion tags] in the scripts.
ELEVENLABS_MODEL_ID=eleven_v4

# Optional: the app name shown on the laptop screen (default: Morphy).
APP_NAME=

# Optional: full path to Google Chrome if it is not in the normal place.
CHROME_PATH=
